{
  "opencollection": "1.0.0",
  "info": {
    "name": "ARMO Platform Customer API (Kubescape) Access Keys Network Policies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Network Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve generated network policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.armosec.io/api/v1/networkPolicies"
          },
          "docs": "Retrieve generated network policies"
        },
        {
          "info": {
            "name": "Generate least-privilege NetworkPolicies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.armosec.io/api/v1/networkPolicies/generate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates Kubernetes NetworkPolicies from observed workload behavior (Bill of Behavior)."
        },
        {
          "info": {
            "name": "Generate seccomp profiles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.armosec.io/api/v1/seccompProfiles/generate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate seccomp profiles"
        }
      ]
    }
  ],
  "bundled": true
}